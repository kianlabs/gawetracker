# GaweTracker — production environment (Oracle Cloud / Ubuntu)
# Copy to .env on the server and fill in the secrets. Never commit the real .env.

APP_NAME=GaweTracker
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set to your real domain (or http://<public-ip> while testing).
APP_URL=https://gawetracker.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gawetracker
DB_USERNAME=gawetracker
DB_PASSWORD=

# ── Session / cache / queue (kept in the DB — no Redis needed on a small VM) ─
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless you use a custom domain; then set to ".yourdomain.com".
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# ── Mail (not used for delivery yet; keeps the driver happy) ─────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Google OAuth (Sign in with Google + Gmail read-only ingestion) ───────────
# Register BOTH redirect URIs on the same OAuth client, in Google Cloud
# Console → Credentials → your client → Authorized redirect URIs:
#   ${APP_URL}/auth/google/callback   (sign in + link mailbox, one step)
#   ${APP_URL}/gmail/callback         (optional: reconnect mailbox later)
# They must match APP_URL exactly — a mismatch makes Google refuse the
# request before the account picker, with "redirect_uri_mismatch".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/gmail/callback"
GOOGLE_LOGIN_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Comma-separated allow-list for "Sign in with Google". Set this in production:
# without it, any Google account could sign in. Existing users are always
# allowed; the first-ever user can bootstrap a fresh install.
GAWETRACKER_ALLOWED_EMAILS=

VITE_APP_NAME="${APP_NAME}"
