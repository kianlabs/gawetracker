# GaweTracker — production environment (Oracle Cloud / Ubuntu)
# Copy to .env on the server and fill in the secrets. Never commit the real .env.

APP_NAME=GaweTracker
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set to your real domain (or http://<public-ip> while testing).
APP_URL=https://gawetracker.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gawetracker
DB_USERNAME=gawetracker
DB_PASSWORD=

# ── Session / cache / queue (kept in the DB — no Redis needed on a small VM) ─
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless you use a custom domain; then set to ".yourdomain.com".
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# ── Mail (not used for delivery yet; keeps the driver happy) ─────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Google OAuth (Gmail read-only ingestion) ────────────────────────────────
# Redirect URI in Google Console must be exactly: ${APP_URL}/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/gmail/callback"

VITE_APP_NAME="${APP_NAME}"
