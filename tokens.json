        "components": [
          0.573,
          0.251,
          0.055
        ],
        "hex": "#92400e"
      }
    },
    "warning-background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.996,
          0.953,
          0.78
        ],
        "hex": "#fef3c7"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
