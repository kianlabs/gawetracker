        "fontFamily": "Plus Jakarta Sans",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
