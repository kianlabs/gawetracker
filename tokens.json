{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Decision-first job application tracker built on shadcn/ui Zinc design tokens, high-density ergonomics, and strict anti-slop design rules.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.094,
          0.094,
          0.106
        ],
        "hex": "#18181b"
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.98,
          0.98,
          0.98
        ],
        "hex": "#fafafa"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.957,
          0.961
        ],
        "hex": "#f4f4f5"
      }
    },
    "secondary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.094,
          0.094,
          0.106
        ],
        "hex": "#18181b"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.957,
          0.961
        ],
        "hex": "#f4f4f5"
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.322,
          0.322,
          0.357
        ],
        "hex": "#52525b"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.957,
          0.961
        ],
        "hex": "#f4f4f5"
      }
    },
    "accent-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.094,
          0.094,
          0.106
        ],
        "hex": "#18181b"
      }
    },
