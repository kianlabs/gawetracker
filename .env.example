APP_NAME=GaweTracker
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Public self-service sign-up. Set to false to close registration and return 404
# on /register (useful to freeze a private instance without a code change).
REGISTRATION_ENABLED=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gawetracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (https://resend.com) powers transactional email, including the email
# verification link. Set MAIL_MAILER=resend and fill RESEND_API_KEY to deliver
# for real; MAIL_FROM_ADDRESS must be on a domain verified in Resend.
RESEND_API_KEY=

# Require a verified email before an account can use the app. Keep this OFF
# until MAIL_MAILER=resend is working: with the default log mailer the link only
# lands in the container log, which would lock every new signup out.
EMAIL_VERIFICATION_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Bootstrap admin account created by database/seeders/UserSeeder.php. New
# visitors can also self-register (REGISTRATION_ENABLED above). Override these
# to set a non-default password when seeding a fresh install. The seeder uses
# firstOrCreate, so changing them later does NOT update the password of an
# already-seeded user — reset it manually or re-seed a new DB.
ADMIN_EMAIL=kyan@gawetracker.test
ADMIN_NAME=Kyan
ADMIN_PASSWORD=password

# Safety guard against wiping the shared production MySQL (see AppServiceProvider
# and AGENTS.md). Destructive commands are refused while DB_DATABASE matches
# GAWETRACKER_SHARED_DB; set GAWETRACKER_ALLOW_DESTRUCTIVE_DB=true only for a
# deliberately isolated rebuild.
GAWETRACKER_SHARED_DB=gawetracker
# GAWETRACKER_ALLOW_DESTRUCTIVE_DB=false

# Job discovery boards (see config/services.php). Defaults target Indonesia;
# override the endpoint/site key to scrape another SEEK market (SG-Main, AU-Main…).
GLINTS_ENDPOINT=https://glints.com/api/v2-alc/graphql
GLINTS_COUNTRY=ID
JOBSTREET_ENDPOINT=https://id.jobstreet.com/api/jobsearch/v5/search
JOBSTREET_SITE_KEY=ID-Main

VITE_APP_NAME="${APP_NAME}"
